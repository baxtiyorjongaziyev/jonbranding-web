# Kod ishlatadigan barcha o'zgaruvchilar. Qiymatlar faqat ommaviy (maxfiy emas) bo'lsa yozilgan.
# Production — Cloudflare Worker secret'lari (`npx wrangler secret put NOMI`), batafsil: docs/KOCHISH.md.
# Yangi o'zgaruvchi qo'shsangiz — shu faylga ham qo'shing (`src/lib/env-example.test.ts` tekshiradi).

# --- Sayt: ommaviy, build vaqtida ---------------------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=h6ymmj0v
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Bo'sh bo'lsa — kod ichidagi standart GA4 / Google Ads ID.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_ADS_CONVERSION_ID=
