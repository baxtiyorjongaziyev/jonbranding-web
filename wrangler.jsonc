{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jonbranding-web",
  "main": ".open-next/worker.js",
  "workers_dev": true,
  "vars": { "TRUSTED_PROXY": "cloudflare" },
  "images": { "binding": "IMAGES" },
  "compatibility_date": "2026-05-10",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "keep_vars": true,
  "minify": true,
  "upload_source_maps": false,
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "jonbranding-web"
    }
  ],
  "routes": [
    { "pattern": "jonbranding.uz", "custom_domain": true },
    { "pattern": "www.jonbranding.uz", "custom_domain": true },
    { "pattern": "patent.jonbranding.uz", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
