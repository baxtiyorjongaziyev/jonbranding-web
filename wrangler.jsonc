{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jonbranding-web",
  "main": ".open-next/security-worker.mjs",
  "workers_dev": true,
  "vars": { "TRUSTED_PROXY": "cloudflare" },
  "ratelimits": [
    { "name": "OISHA_CHAT_BURST", "namespace_id": "2026111401", "simple": { "limit": 5, "period": 10 } },
    { "name": "OISHA_CHAT_MINUTE", "namespace_id": "2026111402", "simple": { "limit": 30, "period": 60 } },
    { "name": "JB_API_LIMIT", "namespace_id": "2026111403", "simple": { "limit": 120, "period": 60 } },
    { "name": "JB_FORM_LIMIT", "namespace_id": "2026111404", "simple": { "limit": 5, "period": 60 } },
    { "name": "JB_CONTACT_LIMIT", "namespace_id": "2026111405", "simple": { "limit": 2, "period": 60 } },
    { "name": "JB_LOGIN_LIMIT", "namespace_id": "2026111406", "simple": { "limit": 5, "period": 60 } },
    { "name": "JB_PAGE_LIMIT", "namespace_id": "2026111407", "simple": { "limit": 120, "period": 60 } },
    { "name": "JB_CHALLENGE_LIMIT", "namespace_id": "2026111408", "simple": { "limit": 10, "period": 60 } }
  ],
  "compatibility_date": "2026-05-10",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": ["/*", "!/_next/static/*"],
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "images": {
    "binding": "IMAGES"
  },
  "keep_vars": true,
  "minify": true,
  "upload_source_maps": false,
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "jonbranding-web"
    }
  ],
  "routes": [
    { "pattern": "jonbranding.uz", "custom_domain": true },
    { "pattern": "www.jonbranding.uz", "custom_domain": true },
    { "pattern": "patent.jonbranding.uz", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
